{
  "name": "sustain-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source deliberate-practice engine for musical instruments — guided daily sessions, measured progress, audio-reactive visuals.",
  "license": "MIT",
  "author": "Isaac Rowntree",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaacrowntree/sustain.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/packs/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '@sustain/*' build",
    "typecheck": "bun run --filter '@sustain/*' typecheck",
    "test": "bun run --filter '@sustain/*' test",
    "dev": "bun run --filter @sustain/web dev"
  }
}
